{
  "name": "busmap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && yarn typecheck",
    "start": "dotenv -- node scripts/start.mjs",
    "lint": "eslint .",
    "prettier": "prettier src --write",
    "prepare": "husky install",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.d1.json",
    "db:generate": "dotenv -- node scripts/database.mjs generate",
    "db:migrate": "dotenv -- node scripts/database.mjs migrate",
    "db:studio": "dotenv -- node scripts/database.mjs studio",
    "db:migrate:d1": "dotenv -v DATABASE_PROVIDER=d1 -- node scripts/database.mjs migrate",
    "db:migrate:d1:remote": "dotenv -v DATABASE_PROVIDER=d1 -- node scripts/database.mjs migrate --remote",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.2.6",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/tanstackstart-react": "^11.7.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.1",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.35.1",
    "animate.css": "^4.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.515.0",
    "maplibre-gl": "^5.6.0",
    "motion": "^12.19.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-map-gl": "^8.0.4",
    "react-timer-hook": "^4.0.5",
    "shadcn": "^4.22.0",
    "simplebar-react": "^3.3.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.5",
    "vaul": "^1.1.2",
    "virtua": "^0.41.5",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.58.2",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/xml2js": "^0.4.13",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "nitro": "3.0.260903-beta",
    "postcss": "^8.5.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.0"
  },
  "lint-staged": {
    "src/**/*": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@10.26.2",
  "resolutions": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
